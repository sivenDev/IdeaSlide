{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IdeaNote",
  "version": "0.9.11",
  "identifier": "com.zhengxiwan.idea-slide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "IdeaNote",
        "width": 1440,
        "height": 875,
        "minWidth": 850,
        "minHeight": 850,
        "titleBarStyle": "Overlay",
        "decorations": true,
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 13,
          "y": 26
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["is"],
        "name": "IdeaNote IdeaSketch",
        "description": "IdeaNote IdeaSketch file",
        "role": "Editor",
        "mimeType": "application/x-ideaslide"
      },
      {
        "ext": ["md"],
        "name": "IdeaNote Markdown",
        "description": "IdeaNote Markdown file",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIyREFDQTcxMkYwOTAyQzkKUldUSkFna3ZjY3JhSWdzRDB4NEU4Vm0zWjNvZitDb2RFRk5UeDBybmltK3Z5Nkx4Y2VnNDc5bUkK",
      "endpoints": [
        "https://gh-proxy.com/https://github.com/sivenDev/IdeaSlide/releases/latest/download/latest-cn.json",
        "https://github.com/sivenDev/IdeaSlide/releases/latest/download/latest.json"
      ]
    }
  }
}
